.env
.codex
config/hypr/host.conf
config/fish/fish_variables*
config/nvim/lazy-lock.json

config/streamcontroller/*
!config/streamcontroller/settings/
!config/streamcontroller/settings/*
config/streamcontroller/settings/settings.json
!config/streamcontroller/pages/
!config/streamcontroller/pages/*
config/streamcontroller/pages/backups/*

config/spicetify/*
!config/spicetify/Themes/*
!config/spicetify/config-xpui.ini
config/cava/shaders/

# WireGuard configs contain private keys
config/wireguard/configs/*.conf
config/hypr/hypridle.conf
config/hypr/hyprlock.conf

# Tide prompt (Fisher-managed runtime files)
config/fish/completions/tide.fish
config/fish/conf.d/_tide_init.fish
config/fish/functions/_tide_*
config/fish/functions/fish_prompt.fish
config/fish/functions/fish_mode_prompt.fish
config/fish/functions/tide.fish
config/fish/functions/tide/

# oh-my-fish/plugin-bang-bang (Fisher-managed runtime files)
config/fish/conf.d/plugin-bang-bang.fish
config/fish/functions/__history_previous_command.fish
config/fish/functions/__history_previous_command_arguments.fish

# catppuccin/fish (Fisher-managed runtime files)
config/fish/themes/catppuccin-*.theme
config/fish/themes/static/

# Yazi flavors (managed by `ya pkg`)
config/yazi/flavors/
config/yazi/package.toml

# Nix build artifacts
result
result-*
*.qcow2
