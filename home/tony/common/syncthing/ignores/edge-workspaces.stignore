// ── heavy / regenerable ─────────────────────────────────────────
(?d)repos
(?d)node_modules
(?d).venv
(?d)__pycache__
(?d)dist
(?d)build
(?d).next
(?d).cache
(?d)target
(?d).pytest_cache
(?d).turbo

// ── git internals: NEVER sync .git via Syncthing ────────────────
// git state moves via remotes (push/pull), not file sync.
// Syncing .git/index, refs, FETCH_HEAD caused the 2026-08-13
// conflict files and risks repo corruption.
(?d).git

// ── machine-local, regenerated by `edge ws sync` ────────────────
// absolute symlinks into ~/.local/share/uv/tools/edge-cli/... -
// path differs per machine, so they arrive dangling elsewhere.
(?d).claude/skills
(?d).codex/skills
(?d).agents/skills
(?d).cursor/rules

// ── machine-local settings / noise ──────────────────────────────
*.backup
(?d)*.sync-conflict-*
.DS_Store
